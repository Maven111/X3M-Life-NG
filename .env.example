# ==============================================================================
# X3M Ideas: Agency Life Simulation - Environment Configuration Template
# ==============================================================================

# Database Connection (Supabase PostgreSQL)
# Pooled connection string (Port 6543) used by Prisma Client at runtime
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection string (Port 5432) used by Prisma CLI for migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase Auth & Storage (Client & Server)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Google Gemini API (Server-side AI evaluation & salary negotiation)
# NEVER expose this key to the browser
GEMINI_API_KEY="AIzaSy..."

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Game Time Configuration (Server Authoritative)
# 1 real minute = 2 in-game minutes (multiplier = 2.0)
GAME_TIME_ACCELERATION_MULTIPLIER=2.0

