# ==============================================================================
# X3M Ideas: Agency Life Simulation - Environment Variable Template
# Note: Variable names only. Do NOT add actual credentials or secret values here.
# Copy this file to .env.local and insert your project credentials.
# ==============================================================================

# Database Connection (Supabase PostgreSQL)
# Pooled connection string (Transaction mode, Port 6543) for Prisma runtime
DATABASE_URL=

# Direct connection string (Session mode, Port 5432) for Prisma migrations
DIRECT_URL=

# Supabase Client & Public Auth (Safe for browser / Client Components)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Privileged Server-Only / NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key (Server-Only AI Evaluation & Creative Direction)
GEMINI_API_KEY=

# Application Base URL
NEXT_PUBLIC_APP_URL=

# Game Time Acceleration Multiplier (1 real min = 2 game mins => 2.0)
GAME_TIME_ACCELERATION_MULTIPLIER=
