// ==============================================================================
// X3M Ideas: Agency Life Simulation — Prisma Schema (Phase 1: Foundational Core)
// Architecture Blueprint: .agents/docs/database-design.md (v2 Approved)
// ==============================================================================
// Phase 1 Scope:
//   1. Player identity & character profiles (players, player_profiles)
//   2. Organisation structure (organisation_units: BU1, BU2, BU3, Finance, HR)
//   3. Career tracks, provisional 5-level roles & fictional game salary bands
//      (career_tracks, salary_bands, job_roles)
//   4. Employment records & career history (employees, career_histories)
//
// Security & Integrity Notes:
//   - Supabase Auth (auth.users) is canonical for credentials and email.
//     players.supabase_auth_id is a logical 1:1 UUID (no cross-schema FK).
//   - All historical/employment/profile FKs use ON DELETE RESTRICT to prevent
//     accidental cascade deletion of player progress and history.
//   - Strict Server-Only RLS is enabled on all tables in the SQL migration.
//   - Partial unique index (one current employment per player) and CHECK
//     constraints are enforced in the SQL migration.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum PlayerStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganisationUnitType {
  BUSINESS_UNIT
  FUNCTIONAL_DEPARTMENT
}

enum EmploymentStatus {
  ONBOARDING
  PROBATION
  ACTIVE
  WARNING_REVIEW
  ON_LEAVE
  TERMINATED
  RESIGNED
}

enum CareerEventType {
  HIRED
  PROMOTED
  TRANSFERRED
  SALARY_ADJUSTED
  TERMINATED
  REHIRED
}

// ------------------------------------------------------------------------------
// Domain 1: Player Identity & Character Profiles
// ------------------------------------------------------------------------------

model Player {
  id             String       @id @default(uuid()) @db.Uuid
  supabaseAuthId String       @unique @map("supabase_auth_id") @db.Uuid
  emailSnapshot  String?      @map("email_snapshot") @db.VarChar(255)
  status         PlayerStatus @default(ACTIVE)
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  profile   PlayerProfile?
  employees Employee[]

  @@map("players")
}

model PlayerProfile {
  id                     String    @id @default(uuid()) @db.Uuid
  playerId               String    @unique @map("player_id") @db.Uuid
  player                 Player    @relation(fields: [playerId], references: [id], onDelete: Restrict)
  displayName            String    @map("display_name") @db.VarChar(80)
  genderPresentation     String    @default("unspecified") @map("gender_presentation") @db.VarChar(32)
  avatarModelKey         String    @default("player-character") @map("avatar_model_key") @db.VarChar(64)
  skinTone               String    @default("default") @map("skin_tone") @db.VarChar(32)
  hairstyle              String    @default("default") @db.VarChar(64)
  outfitKey              String    @default("business_casual") @map("outfit_key") @db.VarChar(64)
  avatarThumbnailUrl     String?   @map("avatar_thumbnail_url")
  absenceProtectionUntil DateTime? @map("absence_protection_until") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("player_profiles")
}

// ------------------------------------------------------------------------------
// Domain 2: Organisation Structure (BU1, BU2, BU3, Finance, HR)
// ------------------------------------------------------------------------------

model OrganisationUnit {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique @db.VarChar(24)
  name        String               @db.VarChar(100)
  unitType    OrganisationUnitType @map("unit_type")
  description String
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz

  employees Employee[]

  @@map("organisation_units")
}

// ------------------------------------------------------------------------------
// Domain 3: Career Tracks, Provisional Roles & Fictional Game Salary Bands
// ------------------------------------------------------------------------------

model CareerTrack {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(32)
  name        String  @db.VarChar(100)
  description String
  isActive    Boolean @default(true) @map("is_active")

  jobRoles JobRole[]

  @@map("career_tracks")
}

model SalaryBand {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(32)
  label         String   @db.VarChar(100)
  minSalary     Int      @map("min_salary")
  maxSalary     Int      @map("max_salary")
  currency      String   @default("NGN") @db.VarChar(8)
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Timestamptz

  jobRoles JobRole[]

  @@map("salary_bands")
}

model JobRole {
  id                String      @id @default(uuid()) @db.Uuid
  careerTrackId     String      @map("career_track_id") @db.Uuid
  careerTrack       CareerTrack @relation(fields: [careerTrackId], references: [id], onDelete: Restrict)
  level             Int
  title             String      @db.VarChar(100)
  description       String
  salaryBandId      String      @map("salary_band_id") @db.Uuid
  salaryBand        SalaryBand  @relation(fields: [salaryBandId], references: [id], onDelete: Restrict)
  promotionCriteria Json?       @map("promotion_criteria")

  employees Employee[]

  @@unique([careerTrackId, level])
  @@unique([careerTrackId, id])
  @@map("job_roles")
}

// ------------------------------------------------------------------------------
// Domain 4: Employment Records & Career History
// ------------------------------------------------------------------------------

model Employee {
  id                 String           @id @default(uuid()) @db.Uuid
  playerId           String           @map("player_id") @db.Uuid
  player             Player           @relation(fields: [playerId], references: [id], onDelete: Restrict)
  organisationUnitId String           @map("organisation_unit_id") @db.Uuid
  organisationUnit   OrganisationUnit @relation(fields: [organisationUnitId], references: [id], onDelete: Restrict)
  careerTrackId      String           @map("career_track_id") @db.Uuid
  jobRoleId          String           @map("job_role_id") @db.Uuid
  jobRole            JobRole          @relation(fields: [careerTrackId, jobRoleId], references: [careerTrackId, id], onDelete: Restrict)
  currentSalary      Int              @map("current_salary")
  performanceScore   Float            @default(70.0) @map("performance_score")
  experiencePoints   Int              @default(0) @map("experience_points")
  warningCount       Int              @default(0) @map("warning_count")
  status             EmploymentStatus @default(PROBATION)
  isCurrent          Boolean          @default(true) @map("is_current")
  hiredAt            DateTime         @default(now()) @map("hired_at") @db.Timestamptz
  hiredGameDay       Int              @default(1) @map("hired_game_day")
  terminatedAt       DateTime?        @map("terminated_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  careerHistories CareerHistory[]

  @@index([playerId, isCurrent])
  @@index([organisationUnitId, status])
  @@map("employees")
}

model CareerHistory {
  id                String          @id @default(uuid()) @db.Uuid
  employeeId        String          @map("employee_id") @db.Uuid
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  eventType         CareerEventType @map("event_type")
  roleTitleSnapshot String          @map("role_title_snapshot") @db.VarChar(100)
  levelSnapshot     Int             @map("level_snapshot")
  unitNameSnapshot  String          @map("unit_name_snapshot") @db.VarChar(100)
  salarySnapshot    Int             @map("salary_snapshot")
  notes             String?
  effectiveAt       DateTime        @default(now()) @map("effective_at") @db.Timestamptz
  effectiveGameDay  Int             @default(1) @map("effective_game_day")

  @@index([employeeId, effectiveAt(sort: Desc)])
  @@map("career_histories")
}
